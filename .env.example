# --- Database (used by docker-compose) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# --- API ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
# Public URL of the web app (links in emails) and of the API (one-click unsubscribe).
# With docker-compose the API is reached through the web app's /api proxy, so both can be the same domain.
APP_URL=https://comms.example.com
API_PUBLIC_URL=https://comms.example.com
COOKIE_SECURE=true

# First admin, created on first start only (change the password after logging in)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# --- Google Workspace mailbox (all emails are sent from this address) ---
MAIL_USER=you@example.com
# OAUTH2 (recommended) | APP_PASSWORD | SMTP (local development, e.g. Mailpit)
# | NONE (no mailbox: emails are only prepared for manual sending; MAIL_USER not needed)
MAIL_AUTH_MODE=OAUTH2
# OAuth client of type "Internal" in your Google Cloud project, refresh token with scope https://mail.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Only for MAIL_AUTH_MODE=APP_PASSWORD (requires 2-Step Verification on the account)
MAIL_APP_PASSWORD=
# Only for MAIL_AUTH_MODE=SMTP
SMTP_HOST=
SMTP_PORT=
