# Coolify deployment config + secrets for Tourney Orga.
# Copy to deploy/.env.coolify (gitignored) and fill in. NEVER commit the real file.
#
#   cp deploy/.env.coolify.example deploy/.env.coolify
#   ./deploy/coolify.sh status     # checks URL + token
#   ./deploy/coolify.sh init       # database + API + UI, then deploys both
#
# Quote values containing special characters, e.g. COOLIFY_API_TOKEN='1|abc'.
# Values left empty below are either optional or generated by `init`
# (POSTGRES_PASSWORD, JWT_SECRET, ADMIN_PASSWORD are written back to this file).

# --- Coolify connection (same instance as challenge-limits) ---
COOLIFY_BASE_URL=https://coolify.example.com
COOLIFY_API_TOKEN=paste-your-coolify-api-token-here
COOLIFY_SERVER_UUID=your-server-uuid            # Coolify > Servers > (server) > UUID

# --- Placement and source (defaults shown) ---
# COOLIFY_PROJECT_NAME=tourney-orga
# COOLIFY_ENVIRONMENT_NAME=production
# COOLIFY_GIT_REPOSITORY=https://github.com/floklaus/tourney-orga
# COOLIFY_GIT_BRANCH=main

# --- Domains (DNS must point at the Coolify server) ---
# APP_DOMAIN=tourney-orga.challenge-limits.com
# API_DOMAIN=tourney-orga-api.challenge-limits.com

# --- Managed PostgreSQL ---
# COOLIFY_DB_NAME=tourney-orga-db
# POSTGRES_USER=tourney_orga
# POSTGRES_DB=tourney_orga
# DB_BACKUP_FREQUENCY=daily        # Coolify cron or daily/weekly/...
# DB_BACKUP_KEEP=14
POSTGRES_PASSWORD=

# --- API secrets ---
JWT_SECRET=

# --- First admin, created on the first start of an empty database ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# --- Mailbox (see README "Google Workspace setup") ---
# NONE = manual sending only (default until a mailbox is configured)
MAIL_AUTH_MODE=NONE
MAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
MAIL_APP_PASSWORD=
